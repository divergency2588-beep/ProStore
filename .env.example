# Pooled connection: приложение (Prisma Client через Neon adapter).
# В hostname должен быть суффикс -pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct connection: Prisma CLI (migrate, studio). Без -pooler.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
